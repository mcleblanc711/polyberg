{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/polymarket-desk/model_trade_response.schema.json",
  "title": "ModelTradeResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "agent_role", "candidate_trades"],
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "agent_role": {
      "type": "string",
      "enum": ["aggressive_trader", "risk_critic", "research_assistant"]
    },
    "candidate_trades": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/candidate_trade"
      }
    }
  },
  "$defs": {
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "shares", "order_type", "rationale"],
      "properties": {
        "price": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "shares": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "order_type": {
          "type": "string",
          "const": "limit"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate_trade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "market_name",
        "side",
        "current_mark",
        "recommendation",
        "confidence",
        "rule_edge",
        "opposing_side_wins_if",
        "correlation",
        "source_quality",
        "thesis_invalidated_if",
        "risk_flags",
        "buy_orders",
        "sell_orders",
        "catalysts",
        "missing_info",
        "human_review_required"
      ],
      "properties": {
        "market_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "market_name": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "enum": ["YES", "NO"]
        },
        "current_mark": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rule_edge": {
          "type": "string",
          "minLength": 1
        },
        "opposing_side_wins_if": {
          "type": "string",
          "minLength": 1
        },
        "correlation": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"]
        },
        "source_quality": {
          "type": "string",
          "enum": [
            "official_resolution_source",
            "credible_reporting",
            "mixed",
            "social_media_rumour",
            "unknown"
          ]
        },
        "thesis_invalidated_if": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "buy_orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          }
        },
        "sell_orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          }
        },
        "catalysts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_info": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_review_required": {
          "const": true
        }
      }
    }
  }
}
