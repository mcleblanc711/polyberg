{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/polyberg/adjudicator_output.schema.json",
  "title": "AdjudicatorOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of",
    "agreed_trades",
    "disputed_trades",
    "rejected_trades",
    "final_order_list",
    "invalidation_triggers",
    "missing_info_checklist",
    "adjudicator_notes"
  ],
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "agreed_trades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trade_note"
      }
    },
    "disputed_trades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trade_note"
      }
    },
    "rejected_trades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trade_note"
      }
    },
    "final_order_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/final_order"
      }
    },
    "invalidation_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_info_checklist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adjudicator_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "trade_note": {
      "type": "object",
      "additionalProperties": true,
      "required": ["market_id", "rationale"],
      "properties": {
        "market_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_model_support": {
          "$ref": "#/$defs/source_model_support"
        }
      }
    },
    "final_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "side",
        "action",
        "price",
        "shares",
        "rationale",
        "source_model_support",
        "human_review_required"
      ],
      "properties": {
        "market_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "enum": ["YES", "NO"]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shares": {
          "type": "number",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_model_support": {
          "$ref": "#/$defs/source_model_support"
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "source_model_support": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
