{
  "name": "polyberg-gui",
  "version": "0.1.0",
  "description": "Polyberg Terminal — Electron GUI for the polyberg research desk",
  "homepage": "https://github.com/mcleblanc711/polyberg",
  "author": "polyberg",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
