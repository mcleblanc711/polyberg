# Local-only API keys and model settings. Do not commit real secrets.
# polyberg CLI auto-loads `.env` from the repo root on every invocation
# (including stages spawned by the Electron GUI). Real shell-env values
# always win over .env, so a CI/systemd setup that injects credentials
# differently is unaffected.
POLYBERG_ENV=local

# Optional future read-only account imports.
# Public Data API positions can use a wallet/proxy-wallet address without API keys.
POLYBERG_PUBLIC_WALLET_ADDRESS=

# OPTIONAL alternative auth path: Polymarket US API credentials. Most users
# will use the CLOB L2 path below instead. If you do supply these, the
# resulting client is GET-only — never put wallet private keys here.
POLYMARKET_US_API_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Proxy wallet (the Polymarket-deployed contract holding funds/positions).
# Used by the unauthenticated positions importer.
POLYMARKET_PROXY_WALLET=

# Polymarket (Polygon) CLOB L2 credentials. Mint once via py-clob-client's
# create_or_derive_api_creds in a SCRATCH directory outside this repo, then
# paste here. Polyberg never touches a private key — only the L2 triple plus
# the signer's EOA address. See docs/account_connection.md.
#
# POLYMARKET_CLOB_SIGNER_ADDRESS is the EOA the private key derives to (the
# address that signed the L1 mint message). This is different from the
# proxy wallet above; the CLOB indexes api_keys by EOA, so this address
# must be sent in the POLY_ADDRESS header on every authenticated request.
POLYMARKET_CLOB_SIGNER_ADDRESS=
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_SECRET=
POLYMARKET_CLOB_PASSPHRASE=
