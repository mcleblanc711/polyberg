.venv/
.env
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

data/snapshots/**
!data/snapshots/.gitkeep

reports/generated/**
!reports/generated/.gitkeep

# Canonical session artifacts (contain .local overlay data — real portfolio,
# proxy_wallet); one dir per packet run under reports/sessions/<session_id>/
reports/sessions/**
!reports/sessions/.gitkeep
reports/latest_session.txt

# Local Claude Code workspace settings
.claude/

# Local-only context overrides (e.g., proxy_wallet, real portfolio, real
# catalyst log kept off-repo)
context/*.local.yaml
context/*.local.md

# Ladder live state (real orders, logs — gitignored; tracked seed is live/target_ladders.yaml)
live/target_ladders.local.yaml
live/order_log.jsonl

# Live order book artifacts (my_resting flags reveal real resting orders)
live/order_books.json
live/order_books.md
live/token_map.json
live/session_starter.md

# Electron GUI build artifacts
gui/node_modules/
gui/out/
gui/dist/
gui/*.tsbuildinfo

# electron-builder buildResources (icons etc) — tracked even though top-level build/ is ignored
!gui/build/
!gui/build/**
