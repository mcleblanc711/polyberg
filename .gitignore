.venv/
.env
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

data/snapshots/**
!data/snapshots/.gitkeep

reports/generated/**
!reports/generated/.gitkeep

# Local Claude Code workspace settings
.claude/

# Local-only context overrides (e.g., proxy_wallet, real portfolio, real
# catalyst log kept off-repo)
context/*.local.yaml
context/*.local.md

# Electron GUI build artifacts
gui/node_modules/
gui/out/
gui/dist/
gui/*.tsbuildinfo

# electron-builder buildResources (icons etc) — tracked even though top-level build/ is ignored
!gui/build/
!gui/build/**
